# ---------------------------------------------------------------------------
# Supabase  ->  Project Settings > API
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# "anon / public" key. Safe to reach the browser - the API serves it to the page.
SUPABASE_ANON_KEY=eyJhbGciOi...

# "service_role" key. SECRET. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Journal owner
# ---------------------------------------------------------------------------
# The handle that owns the journal and the Admin tab.
SUPERADMIN_USERNAME=ROGERB

# One-time code that mints the superadmin account. Use a long random string.
# It stops working the moment the superadmin exists; delete it afterwards.
BOOTSTRAP_INVITE_CODE=change-me-to-something-long-and-random

# Optional: also require the owner to sign in with this exact email/Google account.
# SUPERADMIN_EMAIL=you@gmail.com

# Optional: storage bucket name (defaults to "screenshots").
# SUPABASE_SCREENSHOT_BUCKET=screenshots
